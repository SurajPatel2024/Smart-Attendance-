<%- include("partials/header") %>

<% if(message && message.length > 0){ %>
<div id="popup" class="popup <%= type %> show">
    <%= message %>
</div>
<% } %>

<div class="container">

    <!-- HEADER -->
    <div class="header">
        <div class="school-logo">
            <img src="https://i.ibb.co/SDLXGQ1b/images.png" alt="KSP Logo">
        </div>

        <h1>KSP PUBLIC SCHOOL</h1>

        <p>Smart Attendance Management System</p>

        <div class="date-box" id="liveDate"></div>
    </div>

    <!-- ADD STUDENT -->
    <div class="controls">

        <form action="/add" method="POST">

            <div class="row">

                <select name="cls" required>
                    <option value="">Select Class</option>
                    <option>Nursery</option>
                    <option>LKG</option>
                    <option>UKG</option>
                    <option>1st</option>
                    <option>2nd</option>
                    <option>3rd</option>
                    <option>4th</option>
                    <option>5th</option>
                    <option>6th</option>
                    <option>7th</option>
                    <option>8th</option>
                    <option>9th</option>
                    <option>10th</option>
                </select>

                <input type="number"
                    name="roll"
                    placeholder="Roll Number"
                    required>

                <input type="text"
                    name="name"
                    placeholder="Student Name"
                    required>

                <input type="number"
                    name="phone"
                    placeholder="Mobile Number"
                    required>

                <button type="submit" class="btn-add">
                    ➕ Add Student
                </button>

            </div>

        </form>

    </div>

    <!-- FILTER -->
    <div class="filter-bar">

        <div>
            <strong>📚 Select Class</strong>
        </div>

        <form method="GET" action="/" id="classForm">

            <select name="class" id="classSelect">

                <option value="1st">1st</option>
                <option value="Nursery">Nursery</option>
                <option value="LKG">LKG</option>
                <option value="UKG">UKG</option>
                <option value="2nd">2nd</option>
                <option value="3rd">3rd</option>
                <option value="4th">4th</option>
                <option value="5th">5th</option>
                <option value="6th">6th</option>
                <option value="7th">7th</option>
                <option value="8th">8th</option>
                <option value="9th">9th</option>
                <option value="10th">10th</option>

            </select>

        </form>

    </div>

    <!-- TABLE -->
    <div class="table-container">

        <form action="/attendance-submit" method="POST">

            <table>

                <thead>

                    <tr>
                        <th>Roll</th>
                        <th>Student Name</th>
                        <th>Attendance</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    <% if(students.length === 0){ %>

                    <tr>

                        <td colspan="4"
                            style="text-align:center; padding:30px;">

                            No Students Found

                        </td>

                    </tr>

                    <% } %>

                    <% students.forEach(student => { %>

                    <tr>

                        <td>
                            <strong><%= student.roll %></strong>
                        </td>

                        <td>
                            👨‍🎓
                            <strong><%= student.name %></strong>
                        </td>

                        <td>

                            <select
                                name="status_<%= student._id %>"
                                class="<%= student.status === 'P' ? 'status-present' : 'status-absent' %>"
                                style="padding:6px 10px;">

                                <option value="P"
                                    <%= student.status === 'P' ? 'selected' : '' %>>
                                    ✅ Present
                                </option>

                                <option value="A"
                                    <%= student.status === 'A' ? 'selected' : '' %>>
                                    ❌ Absent
                                </option>

                            </select>

                        </td>

                        <td>

                            <div style="display:flex; gap:5px; justify-content:flex-end;">

                                <% if(student.status === "A") { %>

 <button
    type="button"
    class="btn-whatsapp"
    onclick="sendWhatsApp('<%= student.phone %>','<%= student.name %>')">

    📲 WhatsApp

</button>
     
 <script>

function sendWhatsApp(phone, name){

    const today =
        new Date().toLocaleDateString('en-GB');

    const message =
"Dear Parent,\n" +
"This is to inform you that your child *" +
name.trim() +
"* is absent from KSP PUBLIC SCHOOL today (" +
today +
").\n\n" +

"आदरणीय अभिभावक,\n" +

"सूचित किया जाता है कि आज दिनांक " +
today +
" को आपका बच्चा *" +
name.trim() +
"* विद्यालय में अनुपस्थित है।\n\n\n" +

"Regards,\nPrincipal";

    const whatsappURL =
        "https://wa.me/" +
        phone +
        "?text=" +
        encodeURIComponent(message);

    window.open(whatsappURL, "_blank");

}

</script>

                                <% } %>

                                <button type="button"
                                    class="btn-edit edit-btn"
                                    data-id="<%= student._id %>"
                                    data-cls="<%= student.cls %>"
                                    data-roll="<%= student.roll %>"
                                    data-name="<%= student.name %>"
                                    data-phone="<%= student.phone %>">

                                    ✏ Edit

                                </button>

                            </div>

                        </td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>

            <div style="margin-top:20px; text-align:center;">

                <button type="submit"
                    class="btn-add"
                    style="padding:12px 30px; font-size:1rem;">

                    ✅ Submit Attendance

                </button>

            </div>

        </form>

    </div>

</div>

<!-- EDIT MODAL -->
<div id="editModal" class="modal">

    <div class="modal-content">

        <span class="close-modal"
            onclick="closeModal()">

            &times;

        </span>

        <h2>✏ Edit Student</h2>

        <form id="editForm" method="POST">

            <select name="cls" id="editCls" required>
                <option>Nursery</option>
                <option>LKG</option>
                <option>UKG</option>
                <option>1st</option>
                <option>2nd</option>
                <option>3rd</option>
                <option>4th</option>
                <option>5th</option>
                <option>6th</option>
                <option>7th</option>
                <option>8th</option>
                <option>9th</option>
                <option>10th</option>
            </select>

            <input type="number"
                name="roll"
                id="editRoll"
                placeholder="Roll Number"
                required>

            <input type="text"
                name="name"
                id="editName"
                placeholder="Student Name"
                required>

            <input type="text"
                name="phone"
                id="editPhone"
                placeholder="Phone Number"
                required>

            <button type="submit" class="btn-save">
                💾 Save Changes
            </button>

        </form>

        <form id="deleteForm" method="POST" style="margin-top:10px;">

            <button type="submit"
                class="btn-delete-modal"
                onclick="return confirm('Delete this student?')">

                🗑 Delete Student

            </button>

        </form>

    </div>

</div>

<script>

    /* LIVE DATE */
    const options = {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    };

    document.getElementById('liveDate').innerHTML =
        new Date().toLocaleDateString('en-IN', options);

    /* EDIT MODAL */

    const modal = document.getElementById("editModal");

    document.querySelectorAll(".edit-btn").forEach(button => {

        button.addEventListener("click", function(){

            modal.style.display = "block";

            document.getElementById("editCls").value =
                this.dataset.cls;

            document.getElementById("editRoll").value =
                this.dataset.roll;

            document.getElementById("editName").value =
                this.dataset.name;

            document.getElementById("editPhone").value =
                this.dataset.phone;

            document.getElementById("editForm").action =
                "/edit/" + this.dataset.id;

            document.getElementById("deleteForm").action =
                "/delete/" + this.dataset.id;

        });

    });

    function closeModal(){

        modal.style.display = "none";

    }

    window.addEventListener("click", function(e){

        if(e.target === modal){

            closeModal();

        }

    });

    /* CLASS LOCAL STORAGE */

    const classSelect =
        document.getElementById("classSelect");

    const savedClass =
        localStorage.getItem("selectedClass") || "1st";

    classSelect.value = savedClass;

    if(window.location.search.indexOf("class=") === -1){

        window.location.href = "/?class=" + savedClass;

    }

    classSelect.addEventListener("change", function(){

        localStorage.setItem(
            "selectedClass",
            this.value
        );

        document.getElementById("classForm").submit();

    });

</script>

<%- include("partials/footer") %>